opam-version: "2.0"
version: "0.0.1"
synopsis: "NetKAT: A library for manipulating Finite Automata and Regular Expressions"
maintainer: "jrmcclurg@cornell.edu"
authors: ["Mark Moeller <moeller@cs.cornell.edu>"
          "Nate Foster <jnfoster@cs.cornell.edu>"
          "Alexandra Silva <alexandra.silva@cornell.edu>"
          "Jed McClurg <jrmcclurg@cornell.edu>"
          "Alaia Solko-Breslin <alaia@seas.upenn.edu>"
          "Caleb Koch <ckoch@stanford.edu>"]
homepage: "https://github.com/netkat-lang/netkat"
dev-repo: "git+https://github.com/netkat-lang/netkat"
bug-reports: "https://github.com/netkat-lang/netkat"
license: "Apache-2.0"
build: [
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
  ["dune" "build" "@doc" "-p" name "-j" jobs] {with-doc}
]
depends: [
  "ocaml" {>= "5.3.0"}
  "alcotest" {>= "1.9.0"}
  "dune" {>= "3.19.1"}
  "core" {>= "v0.17.0"}
  "async" {>= "v0.17.0"}

  "yojson" {>= "3.0.0"}
  "sedlex" {>= "3.6"}
  "menhir" {build & >= "20240715"}
  "landmarks-ppx" {>= "1.5"}
  "landmarks" {>= "1.5"}

  "ego" {>= "0.0.6"}
  "z3" {>= "4.15.2"}
]
